QWidget { color: #111111; font-family: "Segoe UI", Arial, sans-serif; font-size: 10pt; }
QMainWindow, QDialog, QStackedWidget { background-color: #f3f3f3; }

QMainWindow {
    background-color: #f4f4f9;
    color: #333;
}

/* Auth Frame Styles */
QFrame#AuthFrame {
    background-color: #ffffff;
    border-radius: 10px;
    padding: 20px;
    border: 1px solid #ccc;
    border-top: 2px solid #0078d7;
}

QLineEdit {
    padding: 10px;
    border-radius: 5px;
    border: 1px solid #ccc;
    background-color: #fff;
    color: #333;
    margin-bottom: 10px;
}

QLineEdit:focus {
    border: 1px solid #0078d7;
}

/* Password Input Composite Widget */
QFrame#PasswordFrame {
    background-color: #fff;
    border: 1px solid #ccc;
    border-radius: 5px;
    margin-bottom: 10px;
}

QFrame#PasswordFrame:hover {
    border: 1px solid #999;
}

QLineEdit#PasswordLineEdit {
    border: none;
    background-color: transparent;
    margin-bottom: 0;
    color: #333;
}

QToolButton#VisibilityButton {
    background-color: transparent;
    border: none;
    color: #888;
    font-size: 16px;
    padding: 0 5px;
}

QToolButton#VisibilityButton:hover { color: #333; }

QPushButton {
    padding: 10px;
    border-radius: 5px;
    background-color: #0078d7;
    color: white;
    font-weight: bold;
}

QPushButton:hover { background-color: #005a9e; }

QPushButton#GoogleButton { background-color: #db4437; margin-top: 5px; }
QPushButton#GoogleButton:hover { background-color: #c53929; }

QLabel { color: #333; font-size: 14px; }
QLabel#LogoLabel { margin-bottom: 10px; }

QLabel#LoginTitle { font-size: 24px; font-weight: bold; margin-bottom: 20px; color: #0078d7; }
QLabel#SignupTitle { font-size: 24px; font-weight: bold; margin-bottom: 20px; color: #28a745; }
QPushButton#SignupButton { background-color: #28a745; }

QPushButton#LinkButton { background-color: transparent; color: #666; border: none; }
QPushButton#LinkButton:hover { color: #333; text-decoration: underline; }

/* Home Window */
QLabel#HomeHeader { font-size: 20px; font-weight: bold; color: #333; padding: 10px; }

QTabWidget::pane { border: 1px solid #ccc; }
QTabBar::tab { background: #e0e0e0; color: #333; padding: 10px; min-width: 100px; }
QTabBar::tab:selected { background: #fff; border-bottom: 2px solid #0078d7; }

QLabel#PlaceholderLabel { color: #888; font-size: 18px; }

/* MessageBox Styles */
QMessageBox { background-color: #fff; color: #333; }
QMessageBox QLabel { color: #333; }
QMessageBox QPushButton { background-color: #0078d7; color: white; border-radius: 5px; padding: 6px 15px; }

/* Password Strength Meter */
QProgressBar#StrengthBar { border: 1px solid #ccc; border-radius: 3px; background-color: #e0e0e0; text-align: center; }

/* Top Navigation Bar */
QFrame#Navbar { background-color: #ffffff; border-bottom: 1px solid #ccc; }
QLabel#NavbarTitle { font-size: 22px; font-weight: bold; color: #0078d7; margin-right: 20px; }

QPushButton#NavButton { background-color: transparent; border: none; color: #666; font-size: 15px; padding: 18px 15px; border-bottom: 3px solid transparent; border-radius: 0px; font-weight: bold; }
QPushButton#NavButton:hover { color: #0078d7; }
QPushButton#NavButton:checked { color: #0078d7; border-bottom: 3px solid #0078d7; }

QPushButton#LogoutButton { background-color: transparent; border: none; color: #dc3545; font-size: 15px; padding: 18px 15px; border-bottom: 3px solid transparent; border-radius: 0px; font-weight: bold; }
QPushButton#LogoutButton:hover { color: #ff6b6b; background-color: rgba(220, 53, 69, 0.1); }

/* Theme Toggle */
QToolButton#ThemeToggleBtn {
    background: transparent;
    border: none;
    font-size: 20px;
    color: #f39c12; /* Sun Color */
}

/* Reusable Card Containers */
#CardContainer, #SIEMSidebar, #ResultFrame {
    background-color: #ffffff;
    border-radius: 8px;
    border: 1px solid #cccccc;
}

/* Tables */
QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f3f3f3;
    border: 1px solid #cccccc;
    border-radius: 6px;
    selection-background-color: #0078d7;
    selection-color: white;
    gridline-color: #cccccc;
}
QHeaderView::section {
    background-color: #ffffff;
    border: none;
    border-bottom: 2px solid #0078d7;
    padding: 5px;
    font-weight: bold;
    color: #111111;
}

/* Progress Bars */
QProgressBar { border: 1px solid #cccccc; border-radius: 6px; text-align: center; background-color: #ffffff; color: #111111; font-weight: bold; }
QProgressBar::chunk { background-color: #0078d7; border-radius: 5px; }

/* SIEM Sidebar Menus */
#SIEMSidebar QPushButton { text-align: left; padding: 12px 20px; border: none; color: #555555; font-size: 14px; background-color: transparent; border-left: 3px solid transparent; border-radius: 0px; }
#SIEMSidebar QPushButton:hover { background-color: #f3f3f3; color: #111111; }
#SIEMSidebar QPushButton:checked { background-color: #f3f3f3; color: #0078d7; font-weight: bold; border-left: 3px solid #0078d7; }

/* Dialog Customizations */
#SuccessDialogContainer { background-color: #ffffff; border: 1px solid #ccc; border-radius: 15px; }
#SuccessIcon { color: #28a745; font-size: 48px; font-weight: bold; }
#LogoutIcon { color: #0078d7; font-size: 48px; font-weight: bold; }
#SuccessTitle { color: #111; font-size: 18px; font-weight: bold; }
#SuccessMsg { color: #555; font-size: 14px; }

/* Action Buttons */
#BtnPrimary { background-color: #0078d7; color: white; padding: 8px; border-radius: 4px; font-weight: bold; }
#BtnSecondary { background-color: #6c757d; color: white; padding: 8px; border-radius: 4px; font-weight: bold; }
#BtnSuccess { background-color: #28a745; color: white; padding: 8px; border-radius: 4px; font-weight: bold; }
#BtnDanger { background-color: #dc3545; color: white; padding: 8px; border-radius: 4px; font-weight: bold; }
#BtnWarning { background-color: #fd7e14; color: white; padding: 8px; border-radius: 4px; font-weight: bold; }
#BtnInfo { background-color: #17a2b8; color: white; padding: 8px; border-radius: 4px; font-weight: bold; }
#BtnPurple { background-color: #6f42c1; color: white; padding: 8px; border-radius: 4px; font-weight: bold; }
#BtnIndigo { background-color: #6610f2; color: white; padding: 8px; border-radius: 4px; font-weight: bold; }
#BtnQuarantine { background-color: #ffc107; color: black; padding: 8px; border-radius: 4px; font-weight: bold; }
#BtnPrimary:hover { background-color: #005a9e; }
#BtnDanger:hover { background-color: #c82333; }

/* Labels and Texts */
#StatusBarLabel { color: #555; }
#InfoLabelBold { font-weight: bold; }
#InfoLabelBoldMb { font-weight: bold; margin-bottom: 5px; }
#LabelSuccess { color: #28a745; }
#LabelPrimary { color: #0078d7; }
#HeaderTitle { font-size: 18px; font-weight: bold; color: #111; }
#ReasonLabel { color: #555; font-style: italic; margin-top: 5px; }
#DetailsLabel { color: #333; margin-top: 10px; border-top: 1px solid #ccc; padding-top: 5px; font-size: 11px; }

/* Dynamic UI Triggers */
#StatusRed { color: #dc3545; font-weight: bold; }
#StatusGreen { color: #28a745; font-weight: bold; }
QLabel[severity="Critical"], QLabel[severity="High"] { color: #dc3545; font-weight: bold; }
QLabel[severity="Medium"] { color: #ffc107; font-weight: bold; }
QLabel[severity="Low"], QLabel[severity="Safe"] { color: #28a745; font-weight: bold; }
QProgressBar#StrengthBar[strength="weak"]::chunk { background-color: #dc3545; }
QProgressBar#StrengthBar[strength="medium"]::chunk { background-color: #ffc107; }
QProgressBar#StrengthBar[strength="strong"]::chunk { background-color: #28a745; }
QLabel#ThreatLabel[risk="Safe"] { color: #28a745; font-weight: bold; font-size: 18pt; }
QLabel#ThreatLabel[risk="LowRisk"] { color: #17a2b8; font-weight: bold; font-size: 18pt; }
QLabel#ThreatLabel[risk="MediumRisk"] { color: #ffc107; font-weight: bold; font-size: 18pt; }
QLabel#ThreatLabel[risk="HighRisk"] { color: #dc3545; font-weight: bold; font-size: 18pt; }
QProgressBar#ScoreBar[risk="Safe"]::chunk { background-color: #28a745; }
QProgressBar#ScoreBar[risk="LowRisk"]::chunk { background-color: #17a2b8; }
QProgressBar#ScoreBar[risk="MediumRisk"]::chunk { background-color: #ffc107; }
QProgressBar#ScoreBar[risk="HighRisk"]::chunk { background-color: #dc3545; }

/* Module Components */
#ConfigCard { background-color: #ffffff; border-radius: 10px; border: 1px solid #cccccc; }
#ConfigCard QLabel { color: #333; font-size: 14px; border: none; }
#ConfigCard QCheckBox { color: #333; font-size: 14px; spacing: 8px; }
#InfoCard { background-color: rgba(0, 0, 0, 0.05); border-radius: 8px; border: 1px solid rgba(0, 0, 0, 0.1); }
#InfoIcon { font-size: 14px; border: none; background: transparent; }
#InfoTitle { color: #555; font-size: 11px; font-weight: bold; border: none; background: transparent; opacity: 0.7; }
#InfoValue { color: #111; font-size: 13px; font-weight: bold; border: none; background: transparent; }
#MetricCard { border-radius: 8px; border: 1px solid rgba(128, 128, 128, 50); background-color: rgba(0, 0, 0, 0.05); }
#MetricTitle { font-size: 11px; font-weight: bold; opacity: 0.7; border: none; background: transparent; color: #333; }
#MetricValue { font-size: 16px; font-weight: bold; border: none; background: transparent; }
#SidebarTitle { color: #555; font-weight: bold; padding-left: 20px; margin-bottom: 10px; text-transform: uppercase; font-size: 11px; }

/* Dropdowns & Inputs */
QComboBox, QTimeEdit { background-color: #ffffff; color: #111111; border: 1px solid #cccccc; border-radius: 4px; padding: 5px; min-width: 100px; }
QComboBox::drop-down { border-left: 1px solid #cccccc; width: 20px; }
QComboBox QAbstractItemView { background-color: #f3f3f3; color: #111111; border: 1px solid #cccccc; selection-background-color: #0078d7; selection-color: white; outline: none; }