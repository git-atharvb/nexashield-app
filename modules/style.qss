QWidget { color: #ffffff; font-family: "Segoe UI", Arial, sans-serif; font-size: 10pt; }
QMainWindow, QDialog, QStackedWidget { background-color: #1e1e1e; }

QMainWindow {
    background-color: #2b2b2b;
}

/* Auth Frame Styles */
QFrame#AuthFrame {
    background-color: #333;
    border-radius: 10px;
    padding: 20px;
    border: 1px solid #555;
    border-top: 2px solid #0078d7; /* Accent line at top */
}

QLineEdit {
    padding: 10px;
    border-radius: 5px;
    border: 1px solid #555;
    background-color: #222;
    color: white;
    margin-bottom: 10px;
}

QLineEdit:focus {
    border: 1px solid #0078d7;
}

/* Password Input Composite Widget */
QFrame#PasswordFrame {
    background-color: #222;
    border: 1px solid #555;
    border-radius: 5px;
    margin-bottom: 10px;
}

QFrame#PasswordFrame:hover {
    border: 1px solid #777;
}

QLineEdit#PasswordLineEdit {
    border: none;
    background-color: transparent;
    margin-bottom: 0;
}

QToolButton#VisibilityButton {
    background-color: transparent;
    border: none;
    color: #888;
    font-size: 16px;
    padding: 0 5px;
}

QToolButton#VisibilityButton:hover { color: #fff; }

QPushButton {
    padding: 10px;
    border-radius: 5px;
    background-color: #0078d7;
    color: white;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #005a9e;
}

QPushButton#GoogleButton {
    background-color: #db4437; /* Google Red */
    margin-top: 5px;
}

QPushButton#GoogleButton:hover {
    background-color: #c53929;
}

QLabel {
    color: white;
    font-size: 14px;
}

QLabel#LogoLabel {
    margin-bottom: 10px;
}

/* Specific Labels */
QLabel#LoginTitle {
    font-size: 24px;
    font-weight: bold;
    margin-bottom: 20px;
    color: #0078d7;
}

QLabel#SignupTitle {
    font-size: 24px;
    font-weight: bold;
    margin-bottom: 20px;
    color: #28a745;
}

/* Specific Buttons */
QPushButton#SignupButton {
    background-color: #28a745;
}

QPushButton#LinkButton {
    background-color: transparent;
    color: #aaa;
    border: none;
}

/* Home Window */
QLabel#HomeHeader {
    font-size: 20px;
    font-weight: bold;
    color: white;
    padding: 10px;
}

QTabWidget::pane {
    border: 1px solid #444;
}

QTabBar::tab {
    background: #333;
    color: #fff;
    padding: 10px;
    min-width: 100px;
}

QTabBar::tab:selected {
    background: #555;
    border-bottom: 2px solid #0078d7;
}

QLabel#PlaceholderLabel {
    color: #888;
    font-size: 18px;
}

/* MessageBox Styles */
QMessageBox {
    background-color: #333;
    color: white;
}

QMessageBox QLabel {
    color: white;
}

QMessageBox QPushButton {
    background-color: #0078d7;
    color: white;
    border-radius: 5px;
    padding: 6px 15px;
}

QMessageBox QPushButton:hover {
    background-color: #005a9e;
}

/* Password Strength Meter */
QProgressBar#StrengthBar {
    border: 1px solid #555;
    border-radius: 3px;
    background-color: #222;
    text-align: center;
}

/* Top Navigation Bar */
QFrame#Navbar {
    background-color: #202020;
    border-bottom: 1px solid #333;
}

QLabel#NavbarTitle {
    font-size: 22px;
    font-weight: bold;
    color: #0078d7;
    margin-right: 20px;
}

QPushButton#NavButton {
    background-color: transparent;
    border: none;
    color: #aaa;
    font-size: 15px;
    padding: 18px 15px;
    border-bottom: 3px solid transparent;
    border-radius: 0px;
    font-weight: bold;
}

QPushButton#NavButton:hover {
    color: white;
}

QPushButton#NavButton:checked {
    color: white;
    border-bottom: 3px solid #0078d7;
}

QPushButton#LogoutButton {
    background-color: transparent;
    border: none;
    color: #dc3545;
    font-size: 15px;
    padding: 18px 15px;
    border-bottom: 3px solid transparent;
    border-radius: 0px;
    font-weight: bold;
}

QPushButton#LogoutButton:hover {
    color: #ff6b6b;
    background-color: rgba(220, 53, 69, 0.1);
}

/* Theme Toggle Button */
QPushButton#ThemeToggle {
    background-color: transparent;
    border: none;
    font-size: 20px;
    border-radius: 20px;
}
QPushButton#ThemeToggle:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

/* Reusable Card Containers */
#CardContainer, #SIEMSidebar, #ResultFrame {
    background-color: #252526;
    border-radius: 8px;
    border: 1px solid #3e3e42;
}

/* Tables */
QTableWidget {
    background-color: #252526;
    alternate-background-color: #1e1e1e;
    border: 1px solid #3e3e42;
    border-radius: 6px;
    selection-background-color: #0078d7;
    selection-color: white;
    gridline-color: #3e3e42;
}
QHeaderView::section {
    background-color: #252526;
    border: none;
    border-bottom: 2px solid #0078d7;
    padding: 5px;
    font-weight: bold;
    color: #ffffff;
}

/* Progress Bars */
QProgressBar { border: 1px solid #3e3e42; border-radius: 6px; text-align: center; background-color: #252526; color: #ffffff; font-weight: bold; }
QProgressBar::chunk { background-color: #0078d7; border-radius: 5px; }

/* SIEM Sidebar Menus */
#SIEMSidebar QPushButton { text-align: left; padding: 12px 20px; border: none; color: #aaaaaa; font-size: 14px; background-color: transparent; border-left: 3px solid transparent; border-radius: 0px; }
#SIEMSidebar QPushButton:hover { background-color: #1e1e1e; color: #ffffff; }
#SIEMSidebar QPushButton:checked { background-color: #1e1e1e; color: #0078d7; font-weight: bold; border-left: 3px solid #0078d7; }

/* Dialog Customizations */
#SuccessDialogContainer { background-color: #1e1e1e; border: 1px solid #333; border-radius: 15px; }
#SuccessIcon { color: #28a745; font-size: 48px; font-weight: bold; }
#LogoutIcon { color: #0078d7; font-size: 48px; font-weight: bold; }
#SuccessTitle { color: white; font-size: 18px; font-weight: bold; }
#SuccessMsg { color: #aaaaaa; font-size: 14px; }

/* Action Buttons */
#BtnPrimary { background-color: #0078d7; color: white; padding: 8px; border-radius: 4px; font-weight: bold; }
#BtnSecondary { background-color: #6c757d; color: white; padding: 8px; border-radius: 4px; font-weight: bold; }
#BtnSuccess { background-color: #28a745; color: white; padding: 8px; border-radius: 4px; font-weight: bold; }
#BtnDanger { background-color: #dc3545; color: white; padding: 8px; border-radius: 4px; font-weight: bold; }
#BtnWarning { background-color: #fd7e14; color: white; padding: 8px; border-radius: 4px; font-weight: bold; }
#BtnInfo { background-color: #17a2b8; color: white; padding: 8px; border-radius: 4px; font-weight: bold; }
#BtnPurple { background-color: #6f42c1; color: white; padding: 8px; border-radius: 4px; font-weight: bold; }
#BtnIndigo { background-color: #6610f2; color: white; padding: 8px; border-radius: 4px; font-weight: bold; }
#BtnQuarantine { background-color: #ffc107; color: black; padding: 8px; border-radius: 4px; font-weight: bold; }
#BtnPrimary:hover { background-color: #005a9e; }
#BtnDanger:hover { background-color: #c82333; }

/* Labels and Texts */
#StatusBarLabel { color: #888; }
#InfoLabelBold { font-weight: bold; }
#InfoLabelBoldMb { font-weight: bold; margin-bottom: 5px; }
#LabelSuccess { color: #28a745; }
#LabelPrimary { color: #0078d7; }
#HeaderTitle { font-size: 18px; font-weight: bold; }
#ReasonLabel { color: #aaa; font-style: italic; margin-top: 5px; }
#DetailsLabel { color: #ccc; margin-top: 10px; border-top: 1px solid #555; padding-top: 5px; font-size: 11px; }

/* Dynamic UI Triggers */
#StatusRed { color: #dc3545; font-weight: bold; }
#StatusGreen { color: #28a745; font-weight: bold; }
QLabel[severity="Critical"], QLabel[severity="High"] { color: #dc3545; font-weight: bold; }
QLabel[severity="Medium"] { color: #ffc107; font-weight: bold; }
QLabel[severity="Low"], QLabel[severity="Safe"] { color: #28a745; font-weight: bold; }
QProgressBar#StrengthBar[strength="weak"]::chunk { background-color: #dc3545; }
QProgressBar#StrengthBar[strength="medium"]::chunk { background-color: #ffc107; }
QProgressBar#StrengthBar[strength="strong"]::chunk { background-color: #28a745; }
QLabel#ThreatLabel[risk="Safe"] { color: #28a745; font-weight: bold; font-size: 18pt; }
QLabel#ThreatLabel[risk="LowRisk"] { color: #17a2b8; font-weight: bold; font-size: 18pt; }
QLabel#ThreatLabel[risk="MediumRisk"] { color: #ffc107; font-weight: bold; font-size: 18pt; }
QLabel#ThreatLabel[risk="HighRisk"] { color: #dc3545; font-weight: bold; font-size: 18pt; }
QProgressBar#ScoreBar[risk="Safe"]::chunk { background-color: #28a745; }
QProgressBar#ScoreBar[risk="LowRisk"]::chunk { background-color: #17a2b8; }
QProgressBar#ScoreBar[risk="MediumRisk"]::chunk { background-color: #ffc107; }
QProgressBar#ScoreBar[risk="HighRisk"]::chunk { background-color: #dc3545; }

/* Module Components */
#ConfigCard { background-color: #252526; border-radius: 10px; border: 1px solid #3e3e42; }
#ConfigCard QLabel { color: #ccc; font-size: 14px; border: none; }
#ConfigCard QCheckBox { color: #ccc; font-size: 14px; spacing: 8px; }
#ConfigCard QComboBox, #ConfigCard QTimeEdit { background-color: #333; color: white; border: 1px solid #555; border-radius: 4px; padding: 5px; min-width: 100px; }
#InfoCard { background-color: rgba(255, 255, 255, 0.05); border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.1); }
#InfoIcon { font-size: 14px; border: none; background: transparent; }
#InfoTitle { color: #aaa; font-size: 11px; font-weight: bold; border: none; background: transparent; opacity: 0.7; }
#InfoValue { color: white; font-size: 13px; font-weight: bold; border: none; background: transparent; }
#MetricCard { border-radius: 8px; border: 1px solid rgba(128, 128, 128, 50); background-color: rgba(0, 0, 0, 20); }
#MetricTitle { font-size: 11px; font-weight: bold; opacity: 0.7; border: none; background: transparent; }
#MetricValue { font-size: 16px; font-weight: bold; border: none; background: transparent; }
#SidebarTitle { color: #666; font-weight: bold; padding-left: 20px; margin-bottom: 10px; text-transform: uppercase; font-size: 11px; }
